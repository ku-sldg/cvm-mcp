{
  "id": "example_hashfile",
  "name": "Example: Single File Integrity",
  "description": "Hash one file and appraise it against a golden value",
  "copland": "lseq( hashfile(example.txt), APPR )",

  "flow": [
    {"type": "asp", "label": "hashfile(example.txt)", "style": "file"},
    {"type": "arrow"},
    {"type": "asp", "label": "APPR", "style": "appr"}
  ],

  "manifest": {
    "ASPS": ["hashfile", "hashfile_appr"],
    "ASP_FS_MAP": {},
    "POLICY": []
  },

  "request": {
    "TYPE": "REQUEST",
    "ACTION": "RUN",
    "ATTESTATION_SESSION": {
      "Session_Plc": "P0",
      "Plc_Mapping": {},
      "PubKey_Mapping": {},
      "Session_Context": {
        "ASP_Types": {
          "hashfile":      {"FWD": {"FWD": "REPLACE", "_BODY": 1}, "ATTRS": []},
          "hashfile_appr": {"FWD": {"FWD": "REPLACE", "_BODY": 1}, "ATTRS": []}
        },
        "ASP_Comps": {"hashfile": "hashfile_appr"}
      }
    },
    "REQ_PLC": "P0",
    "TERM": {
      "TERM_CONSTRUCTOR": "lseq",
      "TERM_BODY": [
        {
          "TERM_CONSTRUCTOR": "asp",
          "TERM_BODY": {
            "ASP_CONSTRUCTOR": "ASPC",
            "ASP_BODY": {
              "ASP_ID": "hashfile",
              "ASP_ARGS": {
                "filepath":        "/path/to/example.txt",
                "env_var":         "",
                "filepath_golden": "/path/to/golden_example.bin",
                "env_var_golden":  "",
                "asp_id_appr":     "hashfile_appr"
              }
            }
          }
        },
        {
          "TERM_CONSTRUCTOR": "asp",
          "TERM_BODY": {"ASP_CONSTRUCTOR": "APPR"}
        }
      ]
    },
    "EVIDENCE": [
      {"RawEv": []},
      {"EvidenceT_CONSTRUCTOR": "mt_evt"}
    ]
  },

  "targets": [
    {
      "id":     "example_file",
      "label":  "example.txt",
      "file":   "/path/to/example.txt",
      "golden": "/path/to/golden_example.bin"
    }
  ]
}
