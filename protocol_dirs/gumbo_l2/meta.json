{
  "name": "GUMBO Contract Attribution (Level 2)",
  "description": "Per-contract range measurements linking AADL GUMBO clauses to GumboX oracle predicates and component BEGIN/END contract blocks. Identifies which specific contract was tampered. AADL and GumboX contracts measured by line range; component contracts measured by BEGIN/END marker strings (stable regardless of implementation code growth).",
  "copland": "lseq( lseq( bseq_chain( readfile_range\u00d716 + readfile_marker_range\u00d74 ), SIG ), APPR )",
  "flow": [
    {
      "type": "bseq",
      "label": "bseq / both_paths",
      "children": [
        "AADL: inv SetPoint_Data_Invariant(aadl_tc_inv_setpoint)",
        "AADL: assume currentTempInputRange(aadl_tc_assume_range)",
        "AADL: guarantee initLatestFanCmd(aadl_tc_init_fan_cmd)",
        "AADL: guarantee initFanCmd(aadl_tc_init_fan)",
        "AADL: guarantee altTempLTSetPoint(aadl_tc_lt)",
        "AADL: guarantee altTempGTSetPoint(aadl_tc_gt)",
        "AADL: guarantee altTempInRange(aadl_tc_inrange)",
        "AADL: guarantee currentTempOutputRange(aadl_ts_output_range)",
        "AADL: guarantee currentTempInitialVal(aadl_ts_init_val)",
        "GumboX TC: I_Assm_currentTemp(gumbox_tc_assm)",
        "GumboX TC: initialize_initLatestFanCmd(gumbox_tc_init_lfc)",
        "GumboX TC: initialize_initFanCmd(gumbox_tc_init_fc)",
        "GumboX TC: compute_spec_LTSetPoint(gumbox_tc_spec_lt)",
        "GumboX TC: compute_spec_GTSetPoint(gumbox_tc_spec_gt)",
        "GumboX TC: compute_spec_InRange(gumbox_tc_spec_inrange)",
        "GumboX TC: compute_case_LTSetPoint(gumbox_tc_case_lt)",
        "GumboX TC: compute_case_GTSetPoint(gumbox_tc_case_gt)",
        "GumboX TC: compute_case_InRange(gumbox_tc_case_inrange)",
        "GumboX TS: I_Guar_currentTemp(gumbox_ts_guar)",
        "GumboX TS: initialize_initializes(gumbox_ts_init)",
        "GumboX TS: inititialize_IEP_Post(gumbox_ts_iep_post)",
        "GumboX TS: compute_CEP_Post(gumbox_ts_cep_post)",
        "TC Component: STATE VARS(comp_tc_state_vars)",
        "TC Component: COMPUTE MODIFIES(comp_tc_compute_mod)",
        "TC Component: COMPUTE ENSURES(comp_tc_compute_ens)",
        "TC Component: INITIALIZES MODIFIES(comp_tc_init_mod)",
        "TC Component: INITIALIZES ENSURES(comp_tc_init_ens)",
        "TS Component: INITIALIZES ENSURES(comp_ts_init_ens)"
      ]
    },
    {
      "type": "arrow"
    },
    {
      "type": "asp",
      "label": "SIG",
      "style": "sig"
    },
    {
      "type": "arrow"
    },
    {
      "type": "asp",
      "label": "APPR",
      "style": "appr"
    }
  ],
  "dynamic": true
}
